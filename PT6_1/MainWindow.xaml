<Window x:Class="PT6_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PT6_1"
        mc:Ignorable="d"
        Title="SimpleDataGridSample" Height="180" Width="400">
    <Grid Margin="10">

        <!-- Ім’я, Відключення автоматичної генерації стовпців, шрифт, фон, контур, розмір шрифту, -->
        <DataGrid Name="dgSimple" AutoGenerateColumns="false" FontFamily="Broadway" Background="#a653ec"
 			BorderBrush="#6d14b8" FontSize="16" RowDetailsVisibilityMode="Visible">
            <!-- Визначення користувацьких стовпців -->
            <DataGrid.Columns>
                <!-- Стовпець, прив’язаний до властивості Name у класі User -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <!-- Стовпець, прив’язаний до властивості Birthday у класі User -->
                <DataGridTextColumn Header="Birthday" Binding="{Binding Birthday}" />
            </DataGrid.Columns>

            <!-- Шаблон для відображення додаткової інформації при розгортанні рядка -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <!-- Відображення тексту з властивості Details -->
                    <TextBlock Text="{Binding Details}" Margin="10" />
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</Window>
